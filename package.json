{
  "name": "tmuxlab",
  "version": "2.10.1",
  "description": "Run coding agents (Claude Code, Codex, …) in parallel in tmux and drive them from a browser or your phone",
  "private": true,
  "license": "MIT",
  "author": "WIRIN-prod",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WIRIN-prod/tmuxlab.git"
  },
  "keywords": [
    "tmux",
    "terminal",
    "claude-code",
    "codex",
    "android",
    "capacitor"
  ],
  "type": "module",
  "bin": {
    "tmuxlab": "bin/tmuxlab.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "start": "node server.js",
    "postinstall": "node scripts/vendor.mjs",
    "build:android": "./scripts/build-apk.sh",
    "icons": "node scripts/icons.mjs",
    "pair": "node scripts/pair.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "sharp": "^0.35.5"
  }
}
